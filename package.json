{
  "name": "didi",
  "version": "0.1.0",
  "description": "A modern pixel art editor, free and everywhere.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix website install",
    "dev": "tauri dev",
    "dev:site": "npm --prefix website run dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && npm run messages || echo ''",
    "check": "svelte-kit sync && npm run messages && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && npm run messages && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check . && eslint . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "build:site": "npm --prefix website run build && node -e \"require('fs').cpSync('website/dist', 'build', { recursive: true })\"",
    "deploy": "npm run build && npm run build:site && wrangler deploy",
    "dev:fake-update": "VITE_DIDI_FAKE_UPDATE=1 tauri dev",
    "build:linux": "tools/build/linux.sh",
    "release:alpha": "node tools/build/release-alpha.mjs"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@lucide/svelte": "^1.66.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "bits-ui": "^2.20.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-message-format": "^4.6.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}

+
+// Didi: see helpers.h.
+
+typedef int32_t int4 __attribute__((vector_size(16)));
+typedef uint32_t uint4 __attribute__((vector_size(16)));
+
+static inline spec4 splat4 (float x) { return (spec4){x, x, x, x}; }
+
+// fastlog2 and fastpow2 (fastapprox), 4 lanes at a time.
+static inline spec4
+vlog2 (spec4 x)
+{
+  int4 i = (int4)x;
+  spec4 m = (spec4)((i & 0x007FFFFF) | 0x3f000000);
+  spec4 y = __builtin_convertvector((uint4)i, spec4) * 1.1920928955078125e-7f;
+  return y - 124.22551499f - 1.498030302f * m - 1.72587999f / (0.3520887068f + m);
+}
+
+static inline spec4
+vpow2 (spec4 p)
+{
+  spec4 offset = (spec4)((int4)(p < 0) & (int4)splat4(1.0f));
+  spec4 clipp = (spec4)(((int4)(p < -126) & (int4)splat4(-126.0f)) | (~(int4)(p < -126) & (int4)p));
+  spec4 w = __builtin_convertvector(__builtin_convertvector(clipp, int4), spec4);
+  spec4 z = clipp - w + offset;
+  spec4 e = (1 << 23) * (clipp + 121.2740575f + 27.7280233f / (4.84252568f - z) - 1.49012907f * z);
+  return (spec4)__builtin_convertvector(e, uint4);
+}
+
+static spec4 SPECTRAL_R[3], SPECTRAL_G[3], SPECTRAL_B[3], T_MATRIX[3][3];
+static int log_tables_ready = 0;
+
+static void
+init_log_tables (void)
+{
+  for (int i = 0; i < 12; i++) {
+    int ok = i < 10;
+    SPECTRAL_R[i / 4][i % 4] = ok ? spectral_r_small[i] : 0;
+    SPECTRAL_G[i / 4][i % 4] = ok ? spectral_g_small[i] : 0;
+    SPECTRAL_B[i / 4][i % 4] = ok ? spectral_b_small[i] : 0;
+    // The unused lanes weigh nothing in the result.
+    for (int c = 0; c < 3; c++) T_MATRIX[c][i / 4][i % 4] = ok ? T_MATRIX_SMALL[c][i] : 0;
+  }
+  log_tables_ready = 1;
+}
+
+void
+rgb_to_log_spectral (float r, float g, float b, LogSpectrum *out)
+{
+  if (!log_tables_ready) init_log_tables();
+  float offset = 1.0 - WGM_EPSILON;
+  r = r * offset + WGM_EPSILON;
+  g = g * offset + WGM_EPSILON;
+  b = b * offset + WGM_EPSILON;
+  for (int k = 0; k < 3; k++) {
+    spec4 s = SPECTRAL_R[k] * r + SPECTRAL_G[k] * g + SPECTRAL_B[k] * b;
+    out->v[k] = vlog2(s);
+  }
+}
+
+void
+log_spectral_mix_to_rgb (const LogSpectrum *a, const LogSpectrum *b, float fac_a, float fac_b, float *rgb_)
+{
+  if (!log_tables_ready) init_log_tables();
+  spec4 sum[3] = {{0}, {0}, {0}};
+  for (int k = 0; k < 3; k++) {
+    spec4 s = vpow2(a->v[k] * fac_a + b->v[k] * fac_b);
+    for (int c = 0; c < 3; c++) sum[c] += T_MATRIX[c][k] * s;
+  }
+  float offset = 1.0 - WGM_EPSILON;
+  for (int c = 0; c < 3; c++) {
+    float t = sum[c][0] + sum[c][1] + sum[c][2] + sum[c][3];
+    rgb_[c] = CLAMP((t - WGM_EPSILON) / offset, 0.0f, 1.0f);
+  }
+}

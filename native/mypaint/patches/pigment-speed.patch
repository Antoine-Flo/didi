+// Didi: faster pigment mixing, same result up to the fast approximations. The weighted
+// geometric mean a^fa * b^fb is computed as 2^(fa*log2(a) + fb*log2(b)), 4 wavelengths at a
+// time (see helpers.h): the dab color's logarithms once per dab, a canvas pixel's only when
+// its color differs from the previous pixel's, and the whole mix reused while neither the
+// color nor the weight changes (flat areas under a hard brush).
+typedef struct {
+  LogSpectrum log_a;
+  LogSpectrum log_b;
+  uint16_t r, g, b, a;
+  int has_b;
+  float fac;
+  int has_result;
+  float result[3];
+} WgmCache;
+
+static void wgm_init(WgmCache *c, uint16_t color_r, uint16_t color_g, uint16_t color_b) {
+  rgb_to_log_spectral((float)color_r / (1 << 15), (float)color_g / (1 << 15),
+                      (float)color_b / (1 << 15), &c->log_a);
+  c->has_b = 0;
+  c->has_result = 0;
+}
+
+/** log2 of the reflectance of a canvas pixel (premultiplied, alpha > 0), cached. */
+static const LogSpectrum *wgm_pixel(WgmCache *c, const uint16_t *rgba) {
+  if (c->has_b && rgba[0] == c->r && rgba[1] == c->g && rgba[2] == c->b && rgba[3] == c->a) {
+    return &c->log_b;
+  }
+  rgb_to_log_spectral((float)rgba[0] / rgba[3], (float)rgba[1] / rgba[3],
+                      (float)rgba[2] / rgba[3], &c->log_b);
+  c->r = rgba[0];
+  c->g = rgba[1];
+  c->b = rgba[2];
+  c->a = rgba[3];
+  c->has_b = 1;
+  c->has_result = 0;
+  return &c->log_b;
+}
+
+/** The dab color mixed into a canvas pixel with weight fac_a, as straight RGB 0..1. */
+static const float *wgm_mix(WgmCache *c, const uint16_t *rgba, float fac_a) {
+  const LogSpectrum *log_b = wgm_pixel(c, rgba);
+  if (c->has_result && c->fac == fac_a) return c->result;
+  log_spectral_mix_to_rgb(&c->log_a, log_b, fac_a, 1.0f - fac_a, c->result);
+  c->fac = fac_a;
+  c->has_result = 1;
+  return c->result;
+}

+// Didi: pigment mixing in the log domain, 4 wavelengths at a time (WebAssembly SIMD).
+// Spectra have 12 lanes, the last 2 unused.
+typedef float spec4 __attribute__((vector_size(16)));
+typedef struct { spec4 v[3]; } LogSpectrum;
+
+/** log2 of the reflectance of a straight RGB color (0..1). */
+void rgb_to_log_spectral (float r, float g, float b, LogSpectrum *out);
+/** 2^(fac_a * a + fac_b * b): the weighted geometric mean of two spectra, as straight RGB. */
+void log_spectral_mix_to_rgb (const LogSpectrum *a, const LogSpectrum *b, float fac_a, float fac_b, float *rgb_);
